# ==========================================================================
# Digital Ainwan: settings
# Easiest way to get a ready file:   node scripts/gen-secrets.mjs
# (it copies this file to ".env" and fills the three secrets with random values)
# Never share ".env" or put it on GitHub. Anyone who has it can open the database.
# ==========================================================================

# --- Address ----------------------------------------------------------------
# Domain people will type, WITHOUT "https://". Its DNS record must already point to this server.
# For a short trial on a bare IP address use ":80" (plain http), and see COOKIE_SECURE below.
SITE_ADDRESS=ainwan.example.in
# The same address WITH "https://". Used in links, the sitemap and WhatsApp previews.
PUBLIC_URL=https://ainwan.example.in
# Leave empty for a normal https website.
# Put "false" ONLY for the trial on a bare IP over http: browsers refuse secure cookies on http.
COOKIE_SECURE=

# --- Secrets: filled by gen-secrets.mjs. Choose them once, before the first start. -----
# (If you type your own: letters and digits only, no @ : / ? # or spaces, and not starting with "-".)
JWT_SECRET=
MONGO_ROOT_PASSWORD=
APP_DB_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Names of the database and its user (the defaults are fine).
#APP_DB_NAME=ainwan
#APP_DB_USER=ainwan
# Hours before an admin has to sign in again (default 8).
#JWT_EXPIRES_HOURS=8
