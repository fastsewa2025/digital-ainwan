{
  "name": "digital-ainwan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API + static host for the Digital Ainwan village portal",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint src tests",
    "seed:admin": "node --env-file-if-exists=../.env src/scripts/seed-admin.js",
    "seed:demo": "node --env-file-if-exists=../.env src/scripts/seed-demo.js",
    "user:reset-password": "node --env-file-if-exists=../.env src/scripts/reset-password.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
